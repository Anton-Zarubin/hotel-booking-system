<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="create_booking_table" author="Anton-Zarubin">
        <createTable tableName="booking">
            <column name="id" type="bigint" autoIncrement="true" defaultOnNull="false" generationType="ALWAYS">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="room_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="check-in" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="check-out" type="date">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="room_id"
                                 baseTableName="booking" constraintName="fk_booking_room"
                                 referencedColumnNames="id" referencedTableName="rooms"/>
    </changeSet>

</databaseChangeLog>